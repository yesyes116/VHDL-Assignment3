<?xml version='1.0' encoding='UTF-8'?>
<project source="5.0.0" version="1.0">
  <lib desc="#Wiring" name="0" />
  <lib desc="#Gates" name="1" />
  <lib desc="#Base" name="2" />
  <main name="main" />
  <options>
    <a name="gateUndefined" val="ignore" />
    <a name="simlimit" val="10000" />
    <a name="simrand" val="0" />
  </options>
  <toolbar>
    <tool lib="2" name="Poke Tool" />
    <tool lib="2" name="Edit Tool" />
    <tool lib="2" name="Wiring Tool" />
    <tool lib="2" name="Text Tool" />
  </toolbar>
  <circuit name="main">
    <a name="appearance" val="logisim_evolution" />
    <comp lib="2" loc="(45,35)" name="Text">
      <a name="text" val="Problem 1. RS Latch" />
      <a name="font" val="SansSerif plain 22" />
      <a name="halign" val="left" />
    </comp>
    <comp lib="2" loc="(45,65)" name="Text">
      <a name="text" val="All pins: 1 bit. Matching tunnel labels are electrically connected." />
      <a name="font" val="SansSerif plain 14" />
      <a name="halign" val="left" />
    </comp>
    <comp lib="0" loc="(80,110)" name="Pin">
      <a name="label" val="s" />
      <a name="facing" val="east" />
      <a name="type" val="input" />
      <a name="appearance" val="NewPins" />
      <a name="labelloc" val="north" />
      <a name="labelfont" val="SansSerif plain 13" />
    </comp>
    <wire from="(80,110)" to="(110,110)" />
    <comp lib="0" loc="(110,110)" name="Tunnel">
      <a name="label" val="s" />
      <a name="facing" val="west" />
      <a name="labelfont" val="SansSerif plain 12" />
    </comp>
    <comp lib="0" loc="(220,110)" name="Pin">
      <a name="label" val="r" />
      <a name="facing" val="east" />
      <a name="type" val="input" />
      <a name="appearance" val="NewPins" />
      <a name="labelloc" val="north" />
      <a name="labelfont" val="SansSerif plain 13" />
    </comp>
    <wire from="(220,110)" to="(250,110)" />
    <comp lib="0" loc="(250,110)" name="Tunnel">
      <a name="label" val="r" />
      <a name="facing" val="west" />
      <a name="labelfont" val="SansSerif plain 12" />
    </comp>
    <comp lib="0" loc="(360,110)" name="Pin">
      <a name="label" val="q" />
      <a name="facing" val="west" />
      <a name="type" val="output" />
      <a name="appearance" val="NewPins" />
      <a name="labelloc" val="north" />
      <a name="labelfont" val="SansSerif plain 13" />
    </comp>
    <wire from="(330,110)" to="(360,110)" />
    <comp lib="0" loc="(330,110)" name="Tunnel">
      <a name="label" val="q" />
      <a name="facing" val="east" />
      <a name="labelfont" val="SansSerif plain 12" />
    </comp>
    <comp lib="0" loc="(500,110)" name="Pin">
      <a name="label" val="qbar" />
      <a name="facing" val="west" />
      <a name="type" val="output" />
      <a name="appearance" val="NewPins" />
      <a name="labelloc" val="north" />
      <a name="labelfont" val="SansSerif plain 13" />
    </comp>
    <wire from="(470,110)" to="(500,110)" />
    <comp lib="0" loc="(470,110)" name="Tunnel">
      <a name="label" val="qbar" />
      <a name="facing" val="east" />
      <a name="labelfont" val="SansSerif plain 12" />
    </comp>
    <comp lib="2" loc="(45,160)" name="Text">
      <a name="text" val="Inputs above are operated with the Poke Tool. Apply initialization before testing Hold." />
      <a name="font" val="SansSerif plain 13" />
      <a name="halign" val="left" />
    </comp>
    <comp lib="2" loc="(140,210)" name="Text">
      <a name="text" val="Cross-coupled NOR gates" />
      <a name="font" val="SansSerif plain 16" />
      <a name="halign" val="left" />
    </comp>
    <comp lib="1" loc="(390,280)" name="NOR Gate">
      <a name="inputs" val="2" />
      <a name="size" val="30" />
    </comp>
    <comp lib="1" loc="(390,440)" name="NOR Gate">
      <a name="inputs" val="2" />
      <a name="size" val="30" />
    </comp>
    <comp lib="0" loc="(300,270)" name="Tunnel">
      <a name="label" val="r" />
      <a name="facing" val="east" />
      <a name="labelfont" val="SansSerif plain 12" />
    </comp>
    <wire from="(300,270)" to="(350,270)" />
    <comp lib="0" loc="(300,450)" name="Tunnel">
      <a name="label" val="s" />
      <a name="facing" val="east" />
      <a name="labelfont" val="SansSerif plain 12" />
    </comp>
    <wire from="(300,450)" to="(350,450)" />
    <wire from="(390,280)" to="(430,280)" />
    <wire from="(430,280)" to="(610,280)" />
    <wire from="(390,440)" to="(460,440)" />
    <wire from="(460,440)" to="(610,440)" />
    <wire from="(430,280)" to="(430,340)" />
    <wire from="(430,340)" to="(310,340)" />
    <wire from="(310,340)" to="(310,430)" />
    <wire from="(310,430)" to="(350,430)" />
    <wire from="(460,440)" to="(460,380)" />
    <wire from="(460,380)" to="(280,380)" />
    <wire from="(280,380)" to="(280,290)" />
    <wire from="(280,290)" to="(350,290)" />
    <comp lib="0" loc="(610,280)" name="Tunnel">
      <a name="label" val="q" />
      <a name="facing" val="west" />
      <a name="labelfont" val="SansSerif plain 12" />
    </comp>
    <comp lib="0" loc="(610,440)" name="Tunnel">
      <a name="label" val="qbar" />
      <a name="facing" val="west" />
      <a name="labelfont" val="SansSerif plain 12" />
    </comp>
    <comp lib="2" loc="(140,520)" name="Text">
      <a name="text" val="s=r=1: q=qbar=0 (forbidden). Recover through Reset or Set." />
      <a name="font" val="SansSerif plain 14" />
      <a name="halign" val="left" />
    </comp>
  </circuit>
</project>